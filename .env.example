# ============================================
# EduRAG environment — copy to .env and edit.
# Read by Docker Compose (docker-compose.yml). Never commit .env.
# ============================================

# --- PostgreSQL (container) ---
POSTGRES_DB=edurag
POSTGRES_USER=edurag_user
POSTGRES_PASSWORD=change_me
# Host port for psql / pgAdmin. Bound to 127.0.0.1 only (not reachable from other machines).
POSTGRES_PORT=5435

# --- pgAdmin (bound to 127.0.0.1 only) ---
PGADMIN_EMAIL=admin@edurag.com
PGADMIN_PASSWORD=change_me
PGADMIN_PORT=5055

# --- Host ports exposed to the network ---
BACKEND_PORT=8988
FRONTEND_PORT=8989

# --- LLM (Anthropic is the only provider) — REQUIRED ---
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Mode ---
# true = run the backend without DB/LLM (mock routers). Keep false for real use.
USE_MOCK_API=false

# --- CORS ---
# Every origin the browser will use to open the frontend: comma-separated, no spaces,
# scheme + host + port. When opening from other devices add that machine's IP or hostname:
#   CORS_ORIGINS=http://192.168.1.10:8989,http://localhost:8989,http://127.0.0.1:8989
CORS_ORIGINS=http://localhost:8989,http://127.0.0.1:8989,http://localhost:5173,http://127.0.0.1:5173

# --- Only when running the backend OUTSIDE Docker ---
# Inside Docker, Compose builds DATABASE_URL from the POSTGRES_* values above.
# DATABASE_URL=postgresql+asyncpg://edurag_user:change_me@localhost:5435/edurag

# --- Public domain via Caddy (docker-compose.caddy.yml, stacked on docker-compose.prod.yml) ---
# Hostname whose DNS A record points to this machine. Caddy obtains the TLS certificate for it.
# SITE_DOMAIN=exam.example.com
# On the production machine, pin the compose files here so no terminal ever falls back to the
# dev files (which would recreate the containers on another network and break Caddy with 502):
# COMPOSE_FILE=docker-compose.prod.yml:docker-compose.caddy.yml
